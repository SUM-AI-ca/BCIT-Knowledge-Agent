# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets — never commit
.env
backend/.env

# Built vector store artifacts (large, regenerable)
backend/vectorstore/

# Retired corpus snapshots kept on disk for rollback
backend/data_old_*/
backend/data/_state/

# Eval run outputs (per-machine measurements, not source)
backend/eval/results/

# Scratch scripts/checks from working sessions (never source)
_tmp_*

# Mined golden-set candidates (working artifacts — promote curated cases
# into golden_set_v3.jsonl instead of committing the raw dump)
backend/eval/candidates_*.jsonl

# Node
frontend/node_modules/

# Build output (regenerate with `npm run build`; deployed via scp, not git)
frontend/dist/

# OS
.DS_Store
Thumbs.db
.gstack/
